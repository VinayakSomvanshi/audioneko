{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "audioneko",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../app/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "audioneko-db",
      "database_id": "013edbba-b34e-4c02-96fa-c4de23ff136e",
      "migrations_dir": "drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "84d4fc2d371540f5b872ec7780ca81a9"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SYNC_ROOM",
        "class_name": "SyncRoom"
      },
      {
        "name": "LISTEN_ALONG_ROOM",
        "class_name": "ListenAlongRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SyncRoom", "ListenAlongRoom"]
    }
  ],
  "triggers": {
    "crons": ["0 */6 * * *"]
  },
  "vars": {
    "GOOGLE_DRIVE_FOLDER_ID": "1Eb41o9yGeJoojEYniUZvRCjaxBziLN-Z"
  },
  "env": {
    "dev": {
      "name": "audioneko-dev",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "audioneko-dev-db",
          "database_id": "15e5049d-aa51-4762-a6d8-c7543a67da9e",
          "migrations_dir": "drizzle"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "69e602f0e84148cbb01c72a5500ad567"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "SYNC_ROOM",
            "class_name": "SyncRoom"
          },
          {
            "name": "LISTEN_ALONG_ROOM",
            "class_name": "ListenAlongRoom"
          }
        ]
      },
      "vars": {
        "APP_ENV": "dev",
        "GOOGLE_DRIVE_FOLDER_ID": "1Eb41o9yGeJoojEYniUZvRCjaxBziLN-Z"
      }
    }
  }
}
